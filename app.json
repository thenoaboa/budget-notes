{
  "expo": {
    "name": "BudgetNote",
    "slug": "budget-notes",
    "scheme": "stretch",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/stretch-icon.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
